# Скрипты для сервера — всегда с переводами строк Linux. С CRLF bash
# отвечает «bad interpreter: No such file or directory», и установка
# падает на первой же строке
*.sh text eol=lf
deploy/*.cron text eol=lf
deploy/*.service text eol=lf

# Шрифты — двоичные: без этого git на Windows может «поправить»
# переводы строк внутри woff2 и файл приедет на сервер битым
*.woff2 binary
*.png binary
