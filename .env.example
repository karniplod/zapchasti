# Скопируйте в .env и заполните. chmod 600 .env — там пароль от базы.
DEBUG=false
BASE_URL=https://razbor.example.ru

DATABASE_URL=postgresql://razbor:ПАРОЛЬ@localhost:5432/razbor
DB_ECHO=false

# openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЕ_МЕНЯ
SESSION_TTL_HOURS=12

IMAGE_MAX_SIDE=1600
THUMB_SIDE=400
MAX_UPLOAD_MB=12
# Пусто = без водяного знака на фото деталей
WATERMARK=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ORDER_NOTIFY_TO=

RESERVE_HOURS=48

# База MaxMind GeoLite2-City для определения города покупателя.
# Файла нет в репозитории — скачайте бесплатно и положите по этому пути.
# Пусто или файла нет = определение выключено, каталог работает как обычно.
GEOIP_DB=data/GeoLite2-City.mmdb

# Внешние источники каталожных номеров (поиск по вебу).
# По умолчанию выключены: стенд не должен ходить на чужие сайты сам.
PARSERS_ENABLED=false

# Поисковик для подсказки номера.
#   brave       — Brave Search API, свой индекс. Ключ берётся на
#                 https://api.search.brave.com/app/keys — заводится
#                 подписка (есть бесплатный тариф), ключ кладётся
#                 в SEARCH_API_KEY. SEARCH_ENGINE_ID не нужен.
#   google      — НЕ РАБОТАЕТ для новых проектов: Custom Search JSON API
#                 закрыт для новых клиентов, 1 января 2027 выключается
#                 совсем. Оставлен для унаследованного доступа. Нужны
#                 ключ и cx:
#                 1) console.cloud.google.com — включить Custom Search API
#                    и создать ключ (APIs & Services -> Credentials)
#                 2) programmablesearchengine.google.com — создать движок
#                    с поиском по всему вебу, взять оттуда «Search engine ID»
#                 Бесплатная квота считается по дням; когда кончится,
#                 придёт 429 и подсказка просто промолчит.
#   duckduckgo  — без ключа, но глушит по IP после десятка запросов.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# Потолок запросов в сутки: внешний поиск платный.
# У Brave $5 кредитов ежемесячно = 1000 запросов, дальше $5 за тысячу.
# В сеть ходим только там, где своя история не дала уверенного ответа,
# поэтому реальный расход заметно ниже числа заведённых деталей.
SEARCH_DAILY_LIMIT=100

# Проверить, что ключ работает:
#   python -m app.scripts.check_search
