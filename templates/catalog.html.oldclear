{% extends "_base.html" %}
{% block title %}Каталог запчастей{% endblock %}

{% block head %}
<style>
/* Первый экран: VIN — единственный вход, всё остальное запасной путь */
.hero{background:var(--surface);border-bottom:1px solid var(--line);padding:44px 0 38px}
.hero h1{margin:0 0 10px}
.hero .lead{margin:0 0 24px}
.vinbar{display:flex;gap:10px;max-width:620px}
.vinbar .field{flex:1;min-width:0}
.vinbar .field.bad{border-color:var(--err)}
.alt{margin:14px 0 0;font-size:var(--t-sm);color:var(--muted)}
.alt button{background:none;border:0;padding:0;font:inherit;color:var(--accent);
  text-decoration:underline;cursor:pointer}

.resolved{max-width:620px;margin-top:20px}
.resolved h3{font-size:var(--t-lg);margin:0 0 4px}
.cands{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.cands button{text-align:left;background:var(--surface);border:1px solid var(--line-2);
  border-radius:8px;padding:9px 13px;font:inherit;font-size:var(--t-sm);cursor:pointer}
.cands button:hover{border-color:var(--accent)}
.cands b{display:block;font-weight:600}
.cands small{color:var(--dim)}

.layout{display:grid;grid-template-columns:224px 1fr;gap:30px;
  padding:26px 0 70px;align-items:start}
@media(max-width:820px){.layout{grid-template-columns:1fr}.side{order:2}}

.side section{margin-bottom:22px}
.side h4{font-family:var(--display);font-size:var(--t-xs);letter-spacing:.16em;
  text-transform:uppercase;color:var(--dim);margin:0 0 9px}
.side label{display:flex;align-items:center;gap:8px;padding:5px 0;
  font-size:var(--t-sm);color:var(--ink);cursor:pointer;margin:0}
.side label input{accent-color:var(--accent)}
.side label .n{margin-left:auto;color:var(--dim);font-size:var(--t-xs);
  font-variant-numeric:tabular-nums}
.side .range{display:flex;gap:8px}
.side .range .field{padding:9px 11px;font-size:var(--t-sm)}
.side .reset{background:none;border:0;padding:0;font:inherit;font-size:var(--t-sm);
  color:var(--accent);text-decoration:underline;cursor:pointer}

.toolbar{display:flex;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
.toolbar .count{font-size:var(--t-sm);color:var(--muted)}
.toolbar select{margin-left:auto;padding:9px 12px;border:1px solid var(--line-2);
  border-radius:8px;background:var(--surface);font:inherit;font-size:var(--t-sm)}

.pager{display:flex;gap:8px;justify-content:center;margin-top:28px;flex-wrap:wrap}
.pager button{background:var(--surface);border:1px solid var(--line-2);
  border-radius:8px;padding:9px 15px;font:inherit;font-size:var(--t-sm);cursor:pointer}
.pager button.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.pager button:disabled{opacity:.4;cursor:not-allowed}
</style>
{% endblock %}

{% block content %}

<section class="hero">
  <div class="wrap">
    <h1>Найдите деталь по VIN</h1>
    <p class="lead">Введите VIN из ПТС или свидетельства о регистрации —
       покажем только то, что встанет на вашу машину.</p>

    <div class="vinbar">
      <input id="vin" class="field field-code" maxlength="17" spellcheck="false"
             autocomplete="off" placeholder="XTA210740X1234567" aria-label="VIN автомобиля">
      <button class="btn btn-primary" id="vinGo" disabled>Подобрать</button>
    </div>

    <p class="alt">VIN под рукой нет?
      <button id="byModel">Выбрать машину по марке и модели</button></p>

    <div id="resolved"></div>
  </div>
</section>

<div class="wrap layout">
  <aside class="side" id="side" hidden>
    <section><h4>Узел</h4><div id="cats"></div></section>
    <section><h4>Состояние</h4><div id="conds"></div></section>
    <section><h4>Цена, ₽</h4>
      <div class="range">
        <input type="number" id="pmin" class="field" placeholder="от" inputmode="numeric">
        <input type="number" id="pmax" class="field" placeholder="до" inputmode="numeric">
      </div>
    </section>
    <button class="reset" id="reset">Сбросить фильтры</button>
  </aside>

  <main>
    <input class="field" id="q" placeholder="Название или каталожный номер"
           autocomplete="off" aria-label="Поиск по названию или номеру"
           style="margin-bottom:16px">
    <div class="toolbar">
      <span class="count" id="count"></span>
      <select id="sort" aria-label="Сортировка">
        <option value="new">Сначала новые</option>
        <option value="price_asc">Сначала дешёвые</option>
        <option value="price_desc">Сначала дорогие</option>
      </select>
    </div>
    <div class="grid" id="grid"></div>
    <div class="pager" id="pager"></div>
  </main>
</div>

{% endblock %}

{% block scripts %}
<script>
const $ = id => document.getElementById(id);
const state = {generation_id:null, modification_id:null, category_id:null,
  condition:[], price_min:null, price_max:null, q:'', sort:'new', page:1};

// ── VIN ──────────────────────────────────────────────────
$('vin').addEventListener('input', e => {
  const v = e.target.value.toUpperCase().replace(/[^A-HJ-NPR-Z0-9]/g,'');
  e.target.value = v; e.target.classList.remove('bad');
  $('vinGo').disabled = v.length !== 17;
});
$('vin').addEventListener('keydown', e => {
  if (e.key === 'Enter' && !$('vinGo').disabled) findByVin(); });
$('vinGo').onclick = findByVin;

async function findByVin(){
  $('vinGo').disabled = true; $('vinGo').textContent = 'Ищу…';
  try {
    const d = await (await fetch('/api/catalog/vin', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({vin: $('vin').value})})).json();
    showResolution(d);
  } finally { $('vinGo').disabled = false; $('vinGo').textContent = 'Подобрать'; }
}

// Предупреждение о комплектации висит всегда: подбор по VIN даёт
// поколение кузова, но не исполнение
const WARN = `<div class="notice notice-warn" style="margin-top:12px">
  Подбор по VIN определяет поколение кузова, но не точную комплектацию.
  Сверьте каталожный номер со своей деталью — это исключит возврат.</div>`;

function showResolution(d){
  const box = $('resolved');

  if (d.resolution === 'invalid'){
    $('vin').classList.add('bad');
    box.innerHTML = `<div class="panel"><h3>Не похоже на VIN</h3>
      <p class="hint" style="margin:4px 0 0">${d.errors.join('. ')}.
      Номер есть в ПТС и на табличке под капотом.</p></div>`;
    return;
  }

  if (d.resolution === 'exact'){
    box.innerHTML = `<div class="notice notice-accent">
      <h3 style="margin:0 0 4px">${d.brand} ${d.model} ${d.generation}${d.body_type ? ', '+d.body_type : ''}</h3>
      <span class="hint">${d.year_from}–${d.year_to || 'н.в.'}${d.year ? ' · ваш год: '+d.year : ''}
        · подходящих деталей: ${d.results_count}</span></div>${WARN}`;
    state.generation_id = d.generation_id;
    state.modification_id = d.modification_id;
    openCatalog(); return;
  }

  if (d.resolution === 'brand_year'){
    box.innerHTML = `<div class="panel">
      <h3>${d.manufacturer}${d.year ? ', '+d.year+' год' : ''}</h3>
      <p class="hint" style="margin:4px 0 0">Точную модель по этому VIN определить
        не удалось. Выберите свою:</p>
      <div class="cands">${d.candidates.map(c => `
        <button data-gen="${c.generation_id}"><b>${c.brand} ${c.model}</b>
          <small>${c.generation}${c.body_type ? ', '+c.body_type : ''} ·
            ${c.year_from}–${c.year_to || 'н.в.'} · ${c.parts_count} дет.</small>
        </button>`).join('')}</div></div>${WARN}`;
    box.querySelectorAll('.cands button').forEach(b => b.onclick = () => {
      state.generation_id = +b.dataset.gen; state.modification_id = null;
      box.querySelector('.cands').remove();
      box.querySelector('h3').textContent = b.querySelector('b').textContent;
      openCatalog();
    });
    return;
  }

  box.innerHTML = `<div class="panel"><h3>Такую машину мы пока не разбирали</h3>
    <p class="hint" style="margin:4px 0 0">${d.country ? d.country+', ' : ''}${d.year ? d.year+' год' : ''} —
      модель определить не смогли. Запрос записан: появится такая машина на разборе,
      детали будут в каталоге. Пока посмотрите общий каталог.</p></div>`;
  openCatalog();
}

$('byModel').onclick = () => { state.generation_id = null; openCatalog(); };

function openCatalog(){
  $('side').hidden = false;
  state.page = 1; state.category_id = null; state.condition = [];
  loadFacets(); loadParts();
  document.querySelector('.layout').scrollIntoView({behavior:'smooth', block:'start'});
}

// ── Фильтры ──────────────────────────────────────────────
async function loadFacets(){
  const p = new URLSearchParams();
  if (state.generation_id) p.set('generation_id', state.generation_id);
  if (state.modification_id) p.set('modification_id', state.modification_id);
  const f = await (await fetch('/api/catalog/facets?'+p)).json();

  $('cats').innerHTML = f.categories.map(c =>
    `<label><input type="radio" name="cat" value="${c.id}">${c.name}
      <span class="n">${c.cnt}</span></label>`).join('')
    || '<p class="hint" style="margin:0">Нет деталей</p>';
  $('cats').querySelectorAll('input').forEach(i => i.onchange = () => {
    state.category_id = +i.value; state.page = 1; loadParts(); });

  $('conds').innerHTML = f.conditions.map(c =>
    `<label><input type="checkbox" value="${c.condition}">${c.condition} — ${c.label}
      <span class="n">${c.cnt}</span></label>`).join('');
  $('conds').querySelectorAll('input').forEach(i => i.onchange = () => {
    state.condition = [...$('conds').querySelectorAll('input:checked')].map(x => x.value);
    state.page = 1; loadParts(); });

  if (f.price.min != null){
    $('pmin').placeholder = 'от '+f.price.min;
    $('pmax').placeholder = 'до '+f.price.max;
  }
}

let debounce;
['pmin','pmax'].forEach(id => $(id).addEventListener('input', () => {
  clearTimeout(debounce);
  debounce = setTimeout(() => {
    state.price_min = $('pmin').value || null;
    state.price_max = $('pmax').value || null;
    state.page = 1; loadParts(); }, 450);
}));
$('q').addEventListener('input', () => {
  clearTimeout(debounce);
  debounce = setTimeout(() => { state.q = $('q').value.trim(); state.page = 1; loadParts(); }, 350);
});
$('sort').onchange = () => { state.sort = $('sort').value; state.page = 1; loadParts(); };
$('reset').onclick = () => {
  Object.assign(state, {category_id:null, condition:[], price_min:null,
    price_max:null, q:'', page:1});
  $('q').value = ''; $('pmin').value = ''; $('pmax').value = '';
  loadFacets(); loadParts();
};

// ── Выдача ───────────────────────────────────────────────
async function loadParts(){
  const p = new URLSearchParams();
  Object.entries(state).forEach(([k,v]) => {
    if (v === null || v === '' || (Array.isArray(v) && !v.length)) return;
    p.set(k, Array.isArray(v) ? v.join(',') : v);
  });

  const d = await (await fetch('/api/catalog/parts?'+p)).json();
  $('count').textContent = d.total
    ? `${d.total} ${plural(d.total,'деталь','детали','деталей')}` : '';

  if (!d.items.length){
    $('grid').innerHTML = `<div class="empty" style="grid-column:1/-1">
      <h3>Ничего не нашлось</h3>
      <p>Уберите часть фильтров или напишите нам — деталь может лежать
         на складе, но ещё не быть выложенной.</p></div>`;
    $('pager').innerHTML = ''; return;
  }

  $('grid').innerHTML = d.items.map(i => {
    // Откуда деталь: с машины или поступила отдельно
    const fit = i.brand ? `${i.brand} ${i.model}${i.year ? ', '+i.year : ''}`
      : i.fits_first ? `${i.fits_first}${i.fits_count > 1 ? ' и ещё '+(i.fits_count-1) : ''}`
      : 'применимость уточняется';
    return `<a class="tag-card" href="/p/${i.sku}">
      <div class="shot">
        ${i.photo ? `<img src="${i.photo}" alt="${i.name}" loading="lazy">`
                  : '<div class="none">фото готовится</div>'}
        <span class="grade" data-g="${i.condition}">${i.condition}</span>
      </div>
      <div class="body">
        <span class="sku">${i.sku}</span>
        <span class="name">${i.name}</span>
        <span class="fit">${fit}</span>
        <span class="price">${i.price ? Number(i.price).toLocaleString('ru')+' ₽'
                                      : 'по запросу'}<small>${i.category}</small></span>
      </div></a>`;
  }).join('');

  renderPager(d);
}

function renderPager(d){
  if (d.pages <= 1){ $('pager').innerHTML = ''; return; }
  let h = `<button ${d.page===1?'disabled':''} data-p="${d.page-1}">Назад</button>`;
  for (let i = 1; i <= d.pages; i++){
    if (i===1 || i===d.pages || Math.abs(i-d.page) <= 1)
      h += `<button class="${i===d.page?'on':''}" data-p="${i}">${i}</button>`;
    else if (Math.abs(i-d.page) === 2) h += '<span style="padding:9px 4px">…</span>';
  }
  h += `<button ${d.page===d.pages?'disabled':''} data-p="${d.page+1}">Вперёд</button>`;
  $('pager').innerHTML = h;
  $('pager').querySelectorAll('button[data-p]').forEach(b => b.onclick = () => {
    state.page = +b.dataset.p; loadParts();
    window.scrollTo({top: document.querySelector('.layout').offsetTop - 20, behavior:'smooth'});
  });
}

const plural = (n,one,few,many) => {
  const a = n % 10, b = n % 100;
  if (a === 1 && b !== 11) return one;
  if (a >= 2 && a <= 4 && (b < 12 || b > 14)) return few;
  return many;
};

$('vin').focus();
</script>
{% endblock %}
