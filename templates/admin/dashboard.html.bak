<!DOCTYPE html>
<html lang="ru"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Сводка</title>
<style>
:root{--bg:#12161c;--panel:#181d25;--line:#2b333f;--ink:#e8ecf2;
--muted:#8794a6;--dim:#5c6878;--amber:#ffc233;--ok:#4cc38a;--warn:#ff9f2e}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.5;
font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
a{color:inherit;text-decoration:none}
.wrap{max-width:900px;margin:0 auto;padding:0 18px 60px}
.top{background:var(--panel);border-bottom:1px solid var(--line);margin-bottom:22px}
.top .wrap{display:flex;align-items:center;gap:14px;padding:14px 18px}
.logo{font-weight:700;font-size:16px}.logo span{color:var(--amber)}
nav{margin-left:auto;display:flex;gap:14px;font-size:14px;color:var(--muted);flex-wrap:wrap}
.me{font-size:12px;color:var(--dim)}
.setup{background:rgba(255,194,51,.09);border:1px solid rgba(255,194,51,.35);
border-radius:12px;padding:18px 20px;margin-bottom:22px}
.setup h2{margin:0 0 8px;font-size:16px}
.setup p{margin:0 0 10px;font-size:14px;color:var(--muted)}
.setup code{background:#1f2630;border:1px solid var(--line);border-radius:6px;
padding:3px 8px;font-size:12px;color:var(--amber);display:inline-block;word-break:break-all}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;
color:var(--dim);font-weight:600;margin:0 0 10px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
gap:11px;margin-bottom:24px}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:14px 16px;display:block;transition:border-color .12s,transform .12s}
.tile:hover{border-color:var(--dim);transform:translateY(-1px)}
.tile.flat{cursor:default}.tile.flat:hover{border-color:var(--line);transform:none}
.tile .n{font-size:26px;font-weight:700;line-height:1.15;font-variant-numeric:tabular-nums}
.tile .l{font-size:12.5px;color:var(--muted);margin-top:2px}
.tile.hot{border-color:rgba(255,159,46,.45);background:rgba(255,159,46,.07)}
.tile.hot .n{color:var(--warn)}.tile.good .n{color:var(--ok)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.panel h3{margin:0 0 12px;font-size:15px}
.car{display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px solid var(--line)}
.car:last-child{border-bottom:0}
.car .code{font-family:ui-monospace,monospace;font-size:13px;color:var(--amber);flex:0 0 60px}
.car .nm{flex:1;min-width:0;font-size:14.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.car .nm small{display:block;color:var(--dim);font-size:12px}
.car .cnt{font-size:13px;color:var(--muted);white-space:nowrap}
.blank{color:var(--dim);font-size:13.5px;margin:0}
.act{display:inline-block;background:var(--amber);color:#1a1408;border-radius:9px;
padding:12px 20px;font-weight:600;font-size:14.5px;margin-bottom:22px}
</style></head><body>

<div class="top"><div class="wrap">
  <span class="logo">РАЗБОР<span>·</span>ПАРТС</span>
  <nav><a href="/intake">Приёмка</a><a href="/catalog">Каталог</a><a href="/logout">Выйти</a></nav>
  <span class="me">{{ user.name or user.login }} · {{ user.role }}</span>
</div></div>

<div class="wrap">

{% if empty %}
<div class="setup">
  <h2>Справочники пустые</h2>
  {% if s.brands == 0 %}
  <p>Марок и моделей нет — форма приёмки откроется, но выбирать в ней нечего.</p>
  <code>python -m app.scripts.import_catalog --file spravochnik.xlsx --source avito --dry-run</code>
  {% endif %}
  {% if s.categories == 0 %}
  <p style="margin-top:12px">Дерево категорий тоже пустое — без него нельзя добавить ни одной детали.</p>
  <code>python -m app.scripts.seed_categories</code>
  {% endif %}
</div>
{% endif %}

<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px">
  <a class="act" style="margin:0" href="/intake">Принять автомобиль</a>
  <a class="act" style="margin:0;background:transparent;color:var(--ink);
     border:1px solid var(--line)" href="/stock/new">Принять запчасть</a>
</div>

<p class="eyebrow">Требует внимания</p>
<div class="tiles">
  <a class="tile {% if s.drafts %}hot{% endif %}" href="/parts?f=draft"><div class="n">{{ s.drafts }}</div><div class="l">черновиков без фото</div></a>
  <a class="tile {% if s.no_price %}hot{% endif %}" href="/parts?f=problems"><div class="n">{{ s.no_price }}</div><div class="l">деталей без цены</div></a>
  <a class="tile {% if s.to_review %}hot{% endif %}" href="/reference/review"><div class="n">{{ s.to_review }}</div><div class="l">справочник на проверку</div></a>
  <a class="tile {% if s.leads %}hot{% endif %}" href="/leads"><div class="n">{{ s.leads }}</div><div class="l">новых заявок</div></a>
</div>

<p class="eyebrow">Склад</p>
<div class="tiles">
  <a class="tile good" href="/parts?f=in_stock"><div class="n">{{ s.in_stock }}</div><div class="l">деталей в наличии</div></a>
  <a class="tile" href="/donors"><div class="n">{{ s.donors }}</div><div class="l">машин принято</div></a>
  <a class="tile" href="/catalog"><div class="n">{{ s.brands }}</div><div class="l">марок в справочнике</div></a>
  <div class="tile flat"><div class="n">{{ s.categories }}</div><div class="l">категорий</div></div>
</div>

<div class="panel">
  <h3>Машины в работе</h3>
  {% if active %}
    {% for c in active %}
    <a class="car" href="/donors/{{ c.id }}/dismantle">
      <span class="code">{{ c.code }}</span>
      <span class="nm">{{ c.brand }} {{ c.model }}
        <small>{{ c.generation }}{% if c.year %}, {{ c.year }}{% endif %}</small></span>
      <span class="cnt">{{ c.parts }} дет.</span>
    </a>
    {% endfor %}
  {% else %}
    <p class="blank">Машин в работе нет. Примите первую — кнопка выше.</p>
  {% endif %}
</div>

</div></body></html>
